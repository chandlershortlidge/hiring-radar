hiringradar.app {
	# Every answer, the password prompt included, says where an agent finds the MCP
	# server (HIR-480): its Server Card and the plain-text llms.txt.
	header Link "<https://hiringradar.app/mcp/server-card>; rel=\"alternate\"; type=\"application/mcp-server-card+json\", <https://hiringradar.app/llms.txt>; rel=\"alternate\"; type=\"text/plain\""
	# The MCP server (HIR-338) is open: no password, rate limited inside the app. So are
	# the pages that tell an agent where it is (HIR-480, app/discovery.py).
	@mcp path /mcp /mcp/server-card /llms.txt /.well-known/ai-catalog.json /.well-known/mcp.json /.well-known/mcp/server-card.json
	handle @mcp {
		reverse_proxy 127.0.0.1:8000
	}
	# Everything else is the dashboard, behind the password.
	handle {
		basicauth {
			chandler REPLACE_WITH_BCRYPT_HASH
		}
		reverse_proxy 127.0.0.1:8000
	}
}

www.hiringradar.app {
	redir https://hiringradar.app{uri} 301
}

# The old address, until 31 Jan 2027 (HIR-458). /mcp is still served here, not redirected,
# so an already-connected Claude keeps working: a redirected POST comes back as a GET,
# which /mcp refuses.
34-159-223-190.sslip.io {
	@mcp path /mcp
	handle @mcp {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		redir https://hiringradar.app{uri} 301
	}
}
