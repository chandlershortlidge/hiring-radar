# Copy to .env (gitignored) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Labeler B in scripts/agent_label.py (HIR-70) defaults to an OpenAI model, so the two blind
# labelers come from different model families. Only that script reads it.
OPENAI_API_KEY=
# Optional: override the extraction model
# HIRING_RADAR_MODEL=claude-sonnet-5-5
# startup.jobs API key (free; create at startup.jobs/account/api_keys). Feed is skipped without it.
STARTUP_JOBS_API_KEY=
# JSearch key (free plan: 200 requests/month) from openwebninja.com/api/jsearch or RapidAPI.
# Feed fails (logged, skipped) without it. JSEARCH_HOST: openwebninja (default) or rapidapi.
JSEARCH_API_KEY=
# JSEARCH_HOST=openwebninja
# Brave Search API key, used only by `discover-boards` (one search per domain x query in
# config/discover.json; $5 per 1,000 searches, $5 free credit a month). api-dashboard.search.brave.com
BRAVE_API_KEY=
# Optional: database path (default ./data/hiring-radar.db)
# HIRING_RADAR_DB=
